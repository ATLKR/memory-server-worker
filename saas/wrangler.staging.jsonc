{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allenlabs-memory-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "9f9fdfcfb6371183304908c2de94513d",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "memory-staging.allenlabs.org", "custom_domain": true }],
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "staging",
    "RELEASE_MODE": "pilot",
    "GA_PROFILE": "managed-ai-metered",
    "PAID_BILLING_ENABLED": "false",
    "MEMORY_ROUTING_ENABLED": "false",
    "MEMORY_GENERAL_ROUTING_ENABLED": "false",
    "MEMORY_SQL_IMPORT_PUBLIC_KEY": "MCowBQYDK2VwAyEAxEGx4nxwhNXsm-kgvivbAdaDcrI_hwty9zq63nvBGoo",
    "MEMORY_SQL_MAINTENANCE": "true",
    "MEMORY_SQL_BACKEND": "durable",
    "MEMORY_SQL_DEPLOYMENT_ID": "memory-staging",
    "MEMORY_SQL_EPOCH": "1",
    "MEMORY_SQL_DATABASES_JSON": "{\"DB\":{\"databaseId\":\"control\",\"kind\":\"control\"},\"HOT_01\":{\"databaseId\":\"hot-01\",\"kind\":\"hot\"},\"HOT_02\":{\"databaseId\":\"hot-02\",\"kind\":\"hot\"}}",
    "ENROLLMENT_MODE": "invite",
    "AI_MONTHLY_BUDGET_MICROUSD": "200000",
    "AUTO_ERASURE_ENABLED": "false",
    "BACKGROUND_JOBS_ENABLED": "true",
    "STORAGE_MODE": "sharded",
    "STORAGE_SHARDS_JSON": "[{\"id\":\"hot-01\",\"binding\":\"HOT_01\",\"mode\":\"active\"},{\"id\":\"hot-02\",\"binding\":\"HOT_02\",\"mode\":\"active\"}]",
    "MAIL_FROM": "memory@allenlabs.org",
    "PUBLIC_ORIGIN": "https://memory-staging.allenlabs.org",
    "SSO_CLIENT_ID": "HrcL1usp3X9w6M9FBrJHdPHjLl9BewMiLcxMi1iCuDA",
    "PRODUCT_NAME": "Memory by Allen Labs · Staging",
    "PRODUCT_SHORT_NAME": "Memory Staging",
    "PRODUCT_DESCRIPTION": "Memory 서비스의 격리된 출시 검증 환경",
    "PRODUCT_SUPPORT_EMAIL": "allenlim@allenlabs.org",
    "PRODUCT_ACCENT_COLOR": "#276747"
  },
  "r2_buckets": [{ "binding": "MEMORY_PAYLOADS", "bucket_name": "allenlabs-memory-staging-payloads" }],
  "durable_objects": { "bindings": [
    { "name": "MEMORY_CONSENT_LEDGER", "class_name": "OrganizationConsentLedger" },
    { "name": "MEMORY_AGENT_MEMORY_SPACES", "class_name": "AgentMemorySpaceLedger" },
    { "name": "MEMORY_AGENT_MEMORY_BUDGET", "class_name": "AgentMemoryBudgetLedger" },
    { "name": "MEMORY_SQL", "class_name": "MemorySqlDatabase" }
  ] },
  "migrations": [
    { "tag": "memory-consent-v1", "new_sqlite_classes": ["OrganizationConsentLedger"] },
    { "tag": "memory-general-v1", "new_sqlite_classes": ["AgentMemorySpaceLedger", "AgentMemoryBudgetLedger"] },
    { "tag": "memory-sql-v1", "new_sqlite_classes": ["MemorySqlDatabase"] }
  ],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "MEMORY_INDEX", "index_name": "allenlabs-memory-staging-index" }],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "allenlabs_memory_staging" }],
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "2086091001", "simple": { "limit": 120, "period": 60 } }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["memory@allenlabs.org"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 1000 }
}
