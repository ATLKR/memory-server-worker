{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allenlabs-memory-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "9f9fdfcfb6371183304908c2de94513d",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "memory-staging.allenlabs.org", "custom_domain": true }],
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "staging",
    "RELEASE_MODE": "pilot",
    "GA_PROFILE": "managed-ai-metered",
    "PAID_BILLING_ENABLED": "false",
    "ENROLLMENT_MODE": "invite",
    "AI_MONTHLY_BUDGET_MICROUSD": "200000",
    "AUTO_ERASURE_ENABLED": "false",
    "BACKGROUND_JOBS_ENABLED": "true",
    "STORAGE_MODE": "sharded",
    "STORAGE_SHARDS_JSON": "[{\"id\":\"hot-01\",\"binding\":\"HOT_01\",\"mode\":\"active\"},{\"id\":\"hot-02\",\"binding\":\"HOT_02\",\"mode\":\"active\"}]",
    "MAIL_FROM": "memory@allenlabs.org",
    "PUBLIC_ORIGIN": "https://memory-staging.allenlabs.org",
    "SSO_CLIENT_ID": "HrcL1usp3X9w6M9FBrJHdPHjLl9BewMiLcxMi1iCuDA",
    "PRODUCT_NAME": "Memory by Allen Labs · Staging",
    "PRODUCT_SHORT_NAME": "Memory Staging",
    "PRODUCT_DESCRIPTION": "Memory 서비스의 격리된 출시 검증 환경",
    "PRODUCT_SUPPORT_EMAIL": "support@allenlabs.org",
    "PRODUCT_ACCENT_COLOR": "#276747"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "allenlabs-memory-staging", "database_id": "92c788b0-9242-46f5-97e2-3c1471e68bb7", "migrations_dir": "migrations" },
    { "binding": "HOT_01", "database_name": "allenlabs-memory-staging-hot-01", "database_id": "0e264d77-4357-4030-943d-1845df4495ed", "migrations_dir": "shard-migrations" },
    { "binding": "HOT_02", "database_name": "allenlabs-memory-staging-hot-02", "database_id": "e3944abb-3341-45b3-ad96-9629d4de8bf9", "migrations_dir": "shard-migrations" }
  ],
  "r2_buckets": [{ "binding": "MEMORY_PAYLOADS", "bucket_name": "allenlabs-memory-staging-payloads" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "MEMORY_INDEX", "index_name": "allenlabs-memory-staging-index" }],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "allenlabs_memory_staging" }],
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "2086091001", "simple": { "limit": 120, "period": 60 } }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["memory@allenlabs.org"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 1000 }
}
