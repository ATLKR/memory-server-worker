{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allenlabs-memory",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "9f9fdfcfb6371183304908c2de94513d",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "memory.allenlabs.org", "custom_domain": true }],
  "vars": {
    "RELEASE_MODE": "pilot",
    "AUTO_ERASURE_ENABLED": "false",
    "MAIL_FROM": "memory@allenlabs.org",
    "LIVE_ACCEPTANCE_ID": "",
    "PUBLIC_ORIGIN": "https://memory.allenlabs.org",
    "SSO_CLIENT_ID": "M5w1jhX2WjRD3PyJDwS_QosyAaHm4TWSyVCkzebqNrA",
    "PRODUCT_NAME": "Memory by Allen Labs",
    "PRODUCT_SHORT_NAME": "Memory",
    "PRODUCT_DESCRIPTION": "에이전트와 팀을 위한 하나의 기억 공간",
    "PRODUCT_SUPPORT_EMAIL": "support@allenlabs.org",
    "PRODUCT_ACCENT_COLOR": "#276747"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "allenlabs-memory-production",
    // Dedicated SaaS database, isolated from the legacy personal service.
    "database_id": "a186c3b4-9092-4619-97b0-cda5b99d9b5d",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "2086090801", "simple": { "limit": 120, "period": 60 } }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["memory@allenlabs.org"] }],
  // Auth callback URLs contain codes: invocation/request logs stay disabled.
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 1000 }
}
