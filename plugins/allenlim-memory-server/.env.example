# Memory Plugin environment configuration.
# Export these variables in your shell or configure them in the plugin host.
# The `mem` CLI does not automatically load `.env` files.

# Base URL of the deployed (or local) memory-server-worker. HTTPS is required
# except for localhost, 127.0.0.0/8, or ::1 development endpoints.
MEMORY_SERVER_URL=https://memory.allenlim.net

# Auth API URL (OAuth login and refresh). HTTPS has the same loopback-only
# development exception. Interactive sessions renew automatically for up to
# 30 days; rotated refresh tokens are stored only in the credential file.
MEMORY_AUTH_API_URL=https://auth-api.allen.company

# API key (optional). Recommended for CI, services, and headless automation.
# When set, this takes precedence over JWT auth. The client sends only the
# x-memory-api-key header; MEMORY_TOKEN and MEMORY_SCOPE are ignored.
# MEMORY_API_KEY=

# JWT bearer token (optional). Used only when MEMORY_API_KEY is empty.
# Overrides the credential file (~/.memory/credentials.json). For interactive
# use, run `mem login` instead.
# MEMORY_TOKEN=

# Optional JWT scope header. Ignored when MEMORY_API_KEY is set. When empty,
# the worker uses the JWT's `sub` (user id).
# MEMORY_SCOPE=

# Per-request timeout in milliseconds. Values are clamped to 100-60000.
# MEMORY_REQUEST_TIMEOUT_MS=10000
