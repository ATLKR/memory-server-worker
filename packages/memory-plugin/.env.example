# Memory Plugin environment configuration.
# Copy to .env and fill in values.

# Base URL of the deployed (or local) memory-server-worker.
MEMORY_SERVER_URL=https://memory.allenlim.net

# Auth API URL (for SSO login). Defaults to the Allen Labs auth server.
MEMORY_AUTH_API_URL=https://auth-api.allen.company

# JWT bearer token (optional). Overrides the credential file (~/.memory/credentials.json).
# For CI/headless use. For interactive use, run `mem login` instead.
# MEMORY_TOKEN=

# Optional scope header. When empty, the worker uses the JWT's `sub` (user id).
# MEMORY_SCOPE=
