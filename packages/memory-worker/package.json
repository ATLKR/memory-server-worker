{
  "name": "memory-worker",
  "version": "3.1.0",
  "private": true,
  "description": "Memory server worker backed by Cloudflare Agent Memory.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "npm run test:node && npm run test:workerd",
    "test:node": "node --import tsx --test --test-concurrency=1 src/*.test.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "migrate:legacy-scope": "node --import tsx scripts/migrate-legacy-scope.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "^5.20260813.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.122.0"
  }
}
