{
  "name": "memory-worker",
  "version": "3.2.1",
  "private": true,
  "description": "Memory server worker backed by Cloudflare Agent Memory.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "npm run check:skills && wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run check:skills && wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "npm run check:skills && npm run test:node && npm run test:workerd",
    "test:node": "node --import tsx --test --test-concurrency=1 src/*.test.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "generate:skills": "node scripts/generate-skills.mjs",
    "check:skills": "node scripts/generate-skills.mjs --check",
    "migrate:legacy-scope": "node --import tsx scripts/migrate-legacy-scope.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.30.1",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20260813.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "wrangler": "^4.152.0"
  }
}
