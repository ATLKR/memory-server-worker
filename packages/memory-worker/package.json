{
  "name": "memory-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker exposing a personal Memory MCP server backed by a Durable Object with SQLite + FTS5 (Cloudflare Agents SDK memory layer).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.14.2",
    "jose": "^5.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.90.1"
  }
}
