{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-server",
  "account_id": "9f9fdfcfb6371183304908c2de94513d",
  "compatibility_date": "2026-08-10",
  // nodejs_compat is required by the Agents SDK (Durable Object durability +
  // node:async_hooks for Cloudflare AsyncLocalStorage context) and by jose
  // (WebCrypto + jose runtime).
  "compatibility_flags": ["nodejs_compat"],

  "main": "src/index.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },

  // Keep the workers.dev subdomain active — the UI worker proxies to this.
  "workers_dev": true,

  "vars": {
    // Allen Labs central auth API. The worker verifies RS256 JWTs minted by
    // this server via its JWKS endpoint ({AUTH_API_URL}/.well-known/jwks.json).
    // JWT issuer + audience must match this URL.
    "AUTH_API_URL": "https://auth-api.allen.company",
    // Auth web UI origin (where the browser sign-in form lives).
    "AUTH_WEB_URL": "https://auth.allen.company",
    // Default logical sub-scope when x-memory-scope is absent.
    // Each scope gets its own Agent Memory profile → isolated memory store.
    // Every logical scope is bound to the JWT `sub`; empty selects the user's
    // personal identity (UUID subjects retain their legacy profile name).
    "DEFAULT_SCOPE": ""
  },

  // Agent Memory binding — Cloudflare's managed memory service.
  // Provides automatic extraction, classification (fact/event/instruction/task),
  // supersession, hybrid search (keyword + semantic), and synthesis.
  // The namespace "memory" was created via:
  //   npx wrangler agent-memory namespace create memory
  // API-key authentication reads the MEMORY_API_KEY_REGISTRY Worker secret.
  // `secrets.required` exposes only its name to typegen/local validation;
  // provision its value interactively and never add that value here:
  //   npx wrangler secret put MEMORY_API_KEY_REGISTRY
  "secrets": {
    "required": ["MEMORY_API_KEY_REGISTRY"]
  },

  "agent_memory": [
    {
      "binding": "MEMORY",
      "namespace": "memory"
    }
  ]

  // No custom domain — the UI worker (memory.allenlim.net) proxies API
  // requests to this worker via a service binding. This keeps MCP, auth,
  // and REST API on the same origin from the browser's perspective.
  //
  // The plugin CLI's MEMORY_SERVER_URL should point to
  // https://memory.allenlim.net (the UI worker), which forwards /mcp
  // and /auth/* to this backend worker.
}
